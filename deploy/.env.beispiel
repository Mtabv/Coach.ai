# Kopie als .env anlegen (cp .env.beispiel .env) und nur auf dem Server ausfüllen.
# Diese Datei NIE ins Repository und nie in einen Chat kopieren.

# Eigene Adresse, ohne https:// (z. B. coach.meine-domain.de). Der DNS-Eintrag muss auf den Server zeigen.
COACHAI_DOMAIN=

# Einmaliger Schlüssel zum Anlegen des ersten Kontos. Erzeugen mit: openssl rand -hex 24
COACHAI_EINRICHTUNGSSCHLUESSEL=

# Schlüssel zwischen App und Datendienst (bleibt auf dem Server). Erzeugen mit: openssl rand -hex 24
COACHAI_DATENDIENST_KEY=
