# HTTPS mit automatischem Zertifikat (Let's Encrypt) für die eigene Domain.
{$COACHAI_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy app:3000
}

# www.<domain> leitet auf die Hauptadresse um.
www.{$COACHAI_DOMAIN} {
	redir https://{$COACHAI_DOMAIN}{uri} permanent
}
