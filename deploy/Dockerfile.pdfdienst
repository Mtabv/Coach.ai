# PDF-Dienst: rendert Spieltagsdossiers mit Chrome zu einer fertigen PDF-Datei. Nur intern erreichbar.
FROM node:22-bookworm-slim
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright NODE_ENV=production
RUN npm init -y >/dev/null \
 && npm install --omit=dev --no-audit --no-fund playwright-core@1.63.0 \
 && npx playwright-core install --with-deps chromium \
 && rm -rf /root/.npm /var/lib/apt/lists/*
COPY tools/pdfdienst/pdfdienst.mjs /app/pdfdienst.mjs
USER node
EXPOSE 8300
CMD ["node", "/app/pdfdienst.mjs"]
